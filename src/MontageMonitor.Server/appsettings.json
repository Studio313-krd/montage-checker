{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Database": {
    "ApplyMigrationsOnStartup": false
  },
  "Security": {
    "JwtIssuer": "MontageMonitor.Server",
    "JwtAudience": "MontageMonitor.Web",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 30,
    "SecureRefreshCookie": true
  },
  "AllowedHosts": "*"
}
