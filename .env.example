MONITOR_DOMAIN=monitor.example.com
ACME_EMAIL=admin@example.com
APP_VERSION=latest
APP_HTTP_PORT=9999
POSTGRES_DB=montage_monitor
POSTGRES_USER=montage_monitor
POSTGRES_PASSWORD=replace-with-a-long-random-password
JWT_SIGNING_KEY=replace-with-at-least-32-random-bytes-use-64
JWT_ISSUER=MontageMonitor.Server
JWT_AUDIENCE=MontageMonitor.Web
OWNER_LOGIN=owner
OWNER_PASSWORD=replace-with-strong-Owner1!
OWNER_DISPLAY_NAME=Владелец
COMPANY_TIME_ZONE=Europe/Moscow
DAILY_OPERATOR_SELECTION_HOUR=6
SCREENSHOT_MAX_UPLOAD_BYTES=8388608
BACKUP_RETENTION_DAYS=14
BACKUP_INTERVAL_SECONDS=86400
BACKUP_RETRY_SECONDS=300
BACKUP_HEALTH_GRACE_SECONDS=1800
BACKUP_ON_START=true
BACKUP_SCREENSHOTS=false
